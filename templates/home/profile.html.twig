<section class="page-section custom-background" id="team">
    <div class="container">
        {% for u in user %}
        <div class="text-center">
            <h2 class="section-heading text-uppercase">Qui suis-je ?</h2>
            <h3 class="section-subheading text-muted custom-styles">{{ u.profile }}</h3>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="team-member">
                    <img class="mx-auto rounded-circle" src="{{ asset('img/profile.jpg') }}" alt="Photo de la développeuse du site" />
                    <h4>Miriam Simonnet</h4>
                    <p class="text-muted">Développeuse Web Backend</p>
                    <a class="btn btn-dark btn-social mx-2" href={{ u.github }}><i class="fab fa-github"></i></a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</section>